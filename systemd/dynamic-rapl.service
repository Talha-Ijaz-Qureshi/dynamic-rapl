[Unit]
Description=Dynamic RAPL (drapl) daemon to enforce per‑state CPU power limits
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/drapld
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target